{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "height": 500,
  "width": 800,
   "data": {
    "url": "https://raw.githubusercontent.com/UmeAC/DV2/refs/heads/main/data/domestic%20dec2024dec2025.csv",
    "format": {"type": "csv"}
   },
  "title": {
    "text": "Australia Regional Expenditure ($M) - Dec 2025",
    "fontSize": 16,
    "fontWeight": "bold"
  },
  "projection": {"type": "mercator"},
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/UmeAC/DV2/refs/heads/main/ne_1-3.json",
        "format": {"type": "topojson", "feature": "ne_10m_admin_1_states_provinces"}
      },
      "transform": [
        {
          "lookup": "properties.name",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/UmeAC/DV2/refs/heads/main/data/domestic%20dec2024dec2025.csv"
            },
            "key": "name",
            "fields": ["Expenditure", "E_change", "night"]
          }
        }
      ],
      "mark": {"type": "geoshape", "stroke": "white"},
      "encoding": {
        "color": {
          "field": "Expenditure",
          "type": "quantitative",
          "title": "Expenditure ($M)",
          "scale": {"scheme": "purples"},
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 220
          }
        },
        "tooltip": [
          {"field": "properties.name", "type": "nominal", "title": "name"},
          {"field": "Expenditure", "type": "quantitative", "title": "Expenditure ($M)"},
          {"field": "E_change", "type": "quantitative", "title": "% Change"}
        ]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/UmeAC/DV2/refs/heads/main/data/domestic%20dec2024dec2025.csv"
      },
      "transform": [
        {"filter": "datum.name == 'Australian Capital Territory'"}
      ],
      "mark": {"type": "point", "opacity": 0, "size": 1000},
      "encoding": {
        "longitude": {"field": "long", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "tooltip": [
          {"field": "name", "type": "nominal", "title": "name"},
          {"field": "Expenditure", "type": "quantitative", "title": "Expenditure ($M)"},
          {"field": "E_change", "type": "quantitative", "title": "% Change"}
        ]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/UmeAC/DV2/refs/heads/main/data/domestic%20dec2024dec2025.csv"
      },
      "mark": {"type": "text", "fontSize": 11, "fontWeight": "bold"},
      "encoding": {
        "longitude": {"field": "long", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "name", "type": "nominal"},
        "color": {
          "condition": {
            "test": "indexof(['Queensland', 'New South Wales', 'Victoria'], datum.name) >= 0",
            "value": "white"
          },
          "value": "black"
        },
        "opacity": {
          "condition": {
            "test": "indexof(['Jervis Bay Territory', 'Australian Capital Territory'], datum.name) >= 0",
            "value": 0
          },
          "value": 1
        }
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/UmeAC/DV2/refs/heads/main/data/domestic%20dec2024dec2025.csv"
      },
      "transform": [
        {"filter": "datum.name == 'Australian Capital Territory'"}
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "black",
        "align": "left",
        "dx": 19
      },
      "encoding": {
        "longitude": {"field": "long", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "name", "type": "nominal"}
      }
    }
  ]
}
