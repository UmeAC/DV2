{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Radial chart: forecasted % growth in overnight trips per state 2024 to 2030",
  "title": {
    "text": "Forecasted Overnight Trip Growth by State: 2024 → 2030 (%)",
    "subtitle": "Arc length = % growth forecast. Inner ring = 2024 base. States sorted by growth.",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "subtitleColor": "#888",
    "fontWeight": "bold",
    "anchor": "start"
  },
  "width": 360,
  "height": 360,
  "data": {
    "url": "domestic_state_trips.csv",
    "format": { "type": "csv", "parse": { "year": "number", "trips": "number" } }
  },
  "transform": [
    { "filter": "datum.year === 2024 || datum.year === 2030" },
    {
      "pivot": "year",
      "value": "trips",
      "groupby": ["state"]
    },
    { "calculate": "((datum['2030'] - datum['2024']) / datum['2024']) * 100", "as": "growth_pct" },
    { "calculate": "datum['2024']", "as": "base_2024" },
    { "calculate": "datum['2030']", "as": "trips_2030" }
  ],
  "layer": [
    {
      "mark": { "type": "arc", "innerRadius": 60, "stroke": "white", "strokeWidth": 1 },
      "encoding": {
        "theta": { "field": "growth_pct", "type": "quantitative", "stack": true },
        "radius": { "field": "base_2024", "type": "quantitative", "scale": { "range": [60, 170] } },
        "color": {
          "field": "state", "type": "nominal", "title": "State",
          "scale": {
            "domain": ["NSW","VIC","QLD","WA","SA","TAS","NT","ACT"],
            "range": ["#7B2D8B","#2196F3","#009E73","#FF9800","#CC79A7","#56B4E9","#F0E442","#E64040"]
          }
        },
        "tooltip": [
          { "field": "state", "type": "nominal", "title": "State" },
          { "field": "base_2024", "type": "quantitative", "title": "2024 Trips ('000)", "format": ",.0f" },
          { "field": "trips_2030", "type": "quantitative", "title": "2030 Trips ('000)", "format": ",.0f" },
          { "field": "growth_pct", "type": "quantitative", "title": "Growth (%)", "format": ".1f" }
        ]
      }
    },
    {
      "mark": { "type": "text", "radiusOffset": 18, "fontSize": 11, "fontWeight": "bold" },
      "encoding": {
        "theta": { "field": "growth_pct", "type": "quantitative", "stack": true },
        "radius": { "field": "base_2024", "type": "quantitative", "scale": { "range": [60, 170] } },
        "text": { "field": "state", "type": "nominal" },
        "color": { "value": "#333" }
      }
    }
  ],
  "config": { "view": { "stroke": null } }
}
